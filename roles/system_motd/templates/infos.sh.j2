#!/bin/bash
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

################################
# colors
################################
GREEN="\e[32m"
YELLOW="\e[33m"
RED="\e[31m"
CYAN="\e[36m"
WHITE="\e[39m"
BOLD_GRAY="\e[1m"
MARGIN_COLOR="\e[38;5;34m"
MARGIN_WARNING_COLOR="\e[38;5;202m"
MARGIN_ALERT_COLOR="\e[38;5;160m"
COLOR_RESET="\e[0m"

function success () { echo -e "${GREEN}${*}${COLOR_RESET}";}
function warning () { echo -e "${YELLOW}${*}${COLOR_RESET}";}
function alert () { echo -e "${RED}${*}${COLOR_RESET}";}
function info () { echo -e "${WHITE}${*}${COLOR_RESET}";}

################################
# Functions
################################
# system uptime
# Return warning if uptime < 1 day
colorize_uptime () {
  uptime=$(cut -f1 -d. /proc/uptime)
  upDays=$((uptime/60/60/24))
  upHours=$((uptime/60/60%24))
  upMins=$((uptime/60%60))
  upSecs=$((uptime%60))
  UPTIME_FORMATTED="$upDays days, $upHours hours, $upMins minutes, $upSecs seconds"
  if [[ "$UPTIME_FORMATTED" =~ ^[0]\ days ]]; then
    warning "${UPTIME_FORMATTED}"
    return 1
  else
    info "${UPTIME_FORMATTED}"
  fi
}

colorize_memory () {
    MEMORY=$(free | awk '/Mem:/ {printf "%d", ($3/$2)*100}')
    if [ "$MEMORY" -gt 90 ]; then
        alert "${MEMORY}%"
        return 100
    elif [ "$MEMORY" -gt 80 ] && [ "$MEMORY" -le 90 ] ; then
        warning "${MEMORY}%"
        return 1
    else
        success "${MEMORY}%"
    fi
}

colorize_swap () {
    SWAP=$(free | awk '/Swap:/ {total=$2; used=$3; if (total==0) {printf "0"} else {printf "%d", (used/total)*100}}')
    if [ "$SWAP" -gt 80 ]; then
        alert "${SWAP}%"
        return 100
    elif [ "$SWAP" -gt 50 ] && [ "$SWAP" -le 80 ] ; then
        warning "${SWAP}%"
        return 1
    else
        success "${SWAP}%"
    fi
}

# Factored load judgment: colorize one load value against thresholds
# $1 = value, $2 = trailing separator ("\c" or "")
judge_load () {
  local val="$1" sep="$2"
  if awk -v l="$val" -v c="$SYS_CORE" 'BEGIN{exit !(l<c)}'; then
      success "${val} ${sep}"
      return 0
  elif awk -v l="$val" -v c="$SYS_CORE_X2" 'BEGIN{exit !(l<c)}'; then
      warning "${val} ${sep}"
      return 1
  else
      alert "${val} ${sep}"
      return 100
  fi
}

colorize_load () {
  # system load (1/5/15 minutes)
  LOAD1=$(awk '{print $1}' /proc/loadavg)
  LOAD5=$(awk '{print $2}' /proc/loadavg)
  LOAD15=$(awk '{print $3}' /proc/loadavg)

  status=0

  MSG1=$(judge_load "$LOAD1" "\c"); c1=$?
  MSG5=$(judge_load "$LOAD5" "\c"); c5=$?
  MSG15=$(judge_load "$LOAD15" ""); c15=$?

  for c in "$c1" "$c5" "$c15"; do
    [ "$c" -eq 100 ] && status=100
    [ "$c" -eq 1 ] && [ "$status" -lt 1 ] && status=1
  done

  echo -n "$MSG1$MSG5$MSG15"
  return $status
}

# Colorize disk usage per mounted filesystem: only the percentage is colored
# (green <=80%, yellow 80-90%, red >90%)
colorize_disk () {
  local worst_status=0
  local output=""
  while read -r mount used_pct free; do
    local pct="${used_pct%\%}"
    local colored_pct
    if [ "$pct" -gt 90 ]; then
        colored_pct=$(alert "${used_pct}")
        worst_status=100
    elif [ "$pct" -gt 80 ] && [ "$pct" -le 90 ]; then
        colored_pct=$(warning "${used_pct}")
        [ "$worst_status" -lt 1 ] && worst_status=1
    else
        colored_pct=$(success "${used_pct}")
    fi
    output+="$(info "${mount} used:") ${colored_pct} $(info "free: ${free}") - "
  done < <(timeout 3s df -Ph | grep mapper | awk '/\// {print $6,$5,$4}')
  # trim trailing " - "
  output="${output% - }"
  echo -n "$output"
  return $worst_status
}

################################
# SYSTEM VARS
################################
HOSTNAME=$(hostname -f 2>/dev/null || uname -n)
SYS_CORE=$(nproc)
SYS_CORE_X2=$((SYS_CORE * 2))
SYS_MEMORY=$(awk '/MemTotal/ {printf "%d", $2/1024/1024 + 1}' /proc/meminfo)
HARDWARE="cpu: $SYS_CORE / memory: $SYS_MEMORY"
IP=$(timeout 2s ip -4 -o addr show scope global | awk '{gsub(/\/.*/,"",$4); print $4}' | grep -v "172\.\(1[6-9]\|2[0-9]\|3[0-1]\)\." | sed ':a;N;$!ba;s/\n/ - /g')
RELEASE="$(. /etc/os-release && echo "$NAME $VERSION_ID")"

# get processes (wc -l includes the header line from ps -Afl, hence the -1)
PSA=$(( $(ps -Afl | wc -l) - 1 ))

###################################
PRIMARY_DISK_CODE=0
{% if motd_check_boot_device is sameas true %}
PRIMARY_DEVICE={{ motd_boot_device }}
PRIMARY_DISK=$(timeout 3s df | awk '$NF == "/" || $NF == "/boot" { print $1}' | grep "$PRIMARY_DEVICE" | wc -l)
if [ "$PRIMARY_DISK" -eq 0 ]; then
    alert "Wrong disk on boot, please reboot your system to fix"
    PRIMARY_DISK_CODE=100
fi
{% endif %}

###################################
# Pending reboot check (kernel update on RHEL-like, or marker file)
PENDING_REBOOT_CODE=0
{% if motd_check_pending_reboot is sameas true %}
if [ -f /var/run/reboot-required ]; then
    PENDING_REBOOT_CODE=100
    alert "Reboot required (kernel/package update)"
elif command -v needs-restarting &>/dev/null && ! needs-restarting -r &>/dev/null; then
    PENDING_REBOOT_CODE=100
    alert "Reboot required (kernel/package update)"
fi
{% endif %}

###################################
# Ansible Roles
ANSIBLE_CODE=0

{% if motd_print_ansible_groups is sameas true %}
ANSIBLE_GROUPS={{ group_names | join(',') }}
if [ "$ANSIBLE_GROUPS" == "ungrouped" ]; then
    alert "This VM is not part of any Ansible group."
    ANSIBLE_CODE=100
fi
{% endif %}

###################################
# Compute statuses

MSG_UPTIME=$(colorize_uptime)
UPTIME_CODE=$?
MSG_LOAD=$(colorize_load)
LOAD_CODE=$?
MSG_MEMORY=$(colorize_memory)
MEMORY_CODE=$?
MSG_SWAP=$(colorize_swap)
SWAP_CODE=$?
MSG_DISK=$(colorize_disk)
DISK_CODE=$?

STATE=0
STATE=$((UPTIME_CODE + LOAD_CODE + MEMORY_CODE + SWAP_CODE + DISK_CODE + PRIMARY_DISK_CODE + PENDING_REBOOT_CODE + ANSIBLE_CODE))

if [ "$STATE" -ge 100 ]; then MARGIN_COLOR=$MARGIN_ALERT_COLOR;
elif [ "$STATE" -ge 1 ] ; then MARGIN_COLOR=$MARGIN_WARNING_COLOR;
else MARGIN_COLOR=$MARGIN_COLOR;
fi

###################################
# Print

echo -en " ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Hostname${COLOR_RESET}.............: $(info "$HOSTNAME")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Hardware${COLOR_RESET}.............: $(info "$HARDWARE")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} IP Address${COLOR_RESET}...........: $(info "$IP")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Release${COLOR_RESET}..............: $(info "$RELEASE")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} System uptime${COLOR_RESET}........: $(echo "$MSG_UPTIME")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Load${COLOR_RESET}.................: $(echo "$MSG_LOAD") (1-5-15 min)
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Memory usage${COLOR_RESET}.........: $(echo "$MSG_MEMORY")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Swap usage${COLOR_RESET}...........: $(echo "$MSG_SWAP")
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Disk usage${COLOR_RESET}...........: $(echo "$MSG_DISK")
{% if motd_print_processes is sameas true %}
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Processes${COLOR_RESET}............: $(info "${PSA}" running)
{% endif %}
{% if motd_print_ansible_groups is sameas true %}
 ${MARGIN_COLOR}█${COLOR_RESET} ${BOLD_GRAY} Ansible Groups${COLOR_RESET}.......: $(info "${ANSIBLE_GROUPS}")
{% endif %}
"
